<ui:FluentWindow x:Class="FS25ModManager.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:FS25ModManager.ViewModels"
                 xmlns:m="clr-namespace:FS25ModManager.Models"
                 xmlns:app="clr-namespace:FS25ModManager"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="{x:Static app:AppInfo.Name}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 AllowDrop="True"
                 DragEnter="Window_DragEnter" DragOver="Window_DragOver"
                 DragLeave="Window_DragLeave" Drop="Window_Drop"
                 Width="1280" Height="820" MinWidth="960" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- Pill-shaped filter button -->
        <Style x:Key="FilterPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Filter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="15" Padding="14,6"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top navigation tab -->
        <Style x:Key="NavTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Margin="0,0,4,0">
                            <Border x:Name="Bd" CornerRadius="6" Padding="14,8" Margin="0,0,0,6">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Bar" Height="3" CornerRadius="1.5" Margin="14,0" VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact list row with a subtle selection highlight -->
        <Style x:Key="ModRowContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small tag shown under a mod title -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Colored status chip for a mod in a savegame -->
        <Style x:Key="SaveStatusChip" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Background" Value="#332E7D32" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:SaveModStatus.Disabled}">
                    <Setter Property="Background" Value="#33FFA000" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:SaveModStatus.NotInstalled}">
                    <Setter Property="Background" Value="#33E53935" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SaveStatusText" TargetType="TextBlock" BasedOn="{StaticResource BadgeText}">
            <Setter Property="Foreground" Value="#FF81C784" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:SaveModStatus.Disabled}">
                    <Setter Property="Foreground" Value="#FFFFCA28" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:SaveModStatus.NotInstalled}">
                    <Setter Property="Foreground" Value="#FFEF9A9A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One mod inside a savegame -->
        <DataTemplate x:Key="SaveModRowTemplate" DataType="{x:Type m:SaveModRow}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding ModName, Mode=OneWay}" /><Run Text="  ·  v" /><Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SaveStatusChip}" VerticalAlignment="Center" MinWidth="84">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SaveStatusText}" HorizontalAlignment="Center" />
                </Border>
                <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Open24}" ToolTip="Show in mod list" Padding="6" Margin="4,0,0,0"
                           Appearance="Transparent"
                           Visibility="{Binding Mod, Converter={StaticResource NotNullToVis}}"
                           Command="{Binding DataContext.ShowModInListCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                           CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- One savegame in the list -->
        <DataTemplate x:Key="SavegameCardTemplate" DataType="{x:Type m:Savegame}">
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="8" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#81C332" Offset="0" />
                            <GradientStop Color="#026D63" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Slot}" FontSize="18" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{Binding MapTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SaveDate, Mode=OneWay, StringFormat='{}{0:yyyy-MM-dd}'}" />
                    </TextBlock>
                    <WrapPanel Margin="0,6,0,0">
                        <Border Style="{StaticResource Badge}" Background="#332E7D32"
                                Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Ready" Style="{StaticResource BadgeText}" Foreground="#FF81C784" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#33FFA000"
                                Visibility="{Binding DisabledNeededCount, Converter={StaticResource PositiveToVis}}">
                            <TextBlock Style="{StaticResource BadgeText}" Foreground="#FFFFCA28">
                                <Run Text="{Binding DisabledNeededCount, Mode=OneWay}" /><Run Text=" in backup" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#33E53935"
                                Visibility="{Binding MissingCount, Converter={StaticResource PositiveToVis}}">
                            <TextBlock Style="{StaticResource BadgeText}" Foreground="#FFEF9A9A">
                                <Run Text="{Binding MissingCount, Mode=OneWay}" /><Run Text=" missing" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding NeededCount, Mode=OneWay}" /><Run Text=" needed" />
                            </TextBlock>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One row in the mod list -->
        <DataTemplate x:Key="ModRowTemplate" DataType="{x:Type m:ModItem}">
            <Grid Margin="0,8" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBox" Width="48" Height="48" CornerRadius="6" ClipToBounds="True"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left">
                    <Grid>
                        <ui:SymbolIcon Symbol="Box24" FontSize="22"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,48,48" RadiusX="6" RadiusY="6" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <WrapPanel Margin="0,4,0,0">
                        <Border Style="{StaticResource Badge}" Background="#332E7D32"
                                Visibility="{Binding MultiplayerSupported, Converter={StaticResource NotNullToVis}}">
                            <TextBlock x:Name="MpText" Text="MP" Style="{StaticResource BadgeText}" Foreground="#FF81C784" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#331E88E5"
                                Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Folder" Style="{StaticResource BadgeText}" Foreground="#FF64B5F6" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#33FFA000"
                                Visibility="{Binding HasDuplicate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Duplicate" Style="{StaticResource BadgeText}" Foreground="#FFFFCA28" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#33FFA000"
                                Visibility="{Binding MissingDependencies, Converter={StaticResource NotNullToVis}}"
                                ToolTip="{Binding MissingDependencies}">
                            <TextBlock Text="Missing dependency" Style="{StaticResource BadgeText}" Foreground="#FFFFCA28" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#33E53935"
                                Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}"
                                ToolTip="{Binding Error}">
                            <TextBlock Text="Unreadable" Style="{StaticResource BadgeText}" Foreground="#FFEF9A9A" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#33E53935"
                                Visibility="{Binding HasInvalidName, Converter={StaticResource BoolToVis}}"
                                ToolTip="The game won't load mods with spaces or symbols in the file name.">
                            <TextBlock Text="Invalid file name" Style="{StaticResource BadgeText}" Foreground="#FFEF9A9A" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#331E88E5"
                                Visibility="{Binding IsMap, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Map" Style="{StaticResource BadgeText}" Foreground="#FF64B5F6" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Visibility="{Binding IsUnused, Converter={StaticResource BoolToVis}}"
                                ToolTip="No savegame needs this mod">
                            <TextBlock Text="Unused" Style="{StaticResource BadgeText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={StaticResource BytesToString}}"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"
                           MinWidth="60" TextAlignment="Right" />

                <Grid Grid.Column="3" VerticalAlignment="Center" Width="56">
                    <ui:ToggleSwitch IsChecked="{Binding IsActive, Mode=OneWay}"
                                     Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                     CommandParameter="{Binding}"
                                     ToolTip="Enable / disable"
                                     Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}" />
                    <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" HorizontalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="IconBox" Property="Opacity" Value="0.45" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding MultiplayerSupported}" Value="False">
                    <Setter TargetName="MpText" Property="Text" Value="SP only" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static app:AppInfo.Name}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-small.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ═════════════ Navigation ═════════════ -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource NavTab}" Content="Mods"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AppPage.Mods}}" />
                <RadioButton Style="{StaticResource NavTab}" Content="Savegames"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AppPage.Savegames}}" />
                <RadioButton Style="{StaticResource NavTab}" Content="About"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AppPage.About}}" />
            </StackPanel>

            <!-- Update ready: one click installs it; otherwise it installs when the app closes -->
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}"
                       ToolTip="{Binding UpdateStatus}"
                       Command="{Binding RestartToUpdateCommand}">
                <TextBlock>
                    <Run Text="v" /><Run Text="{Binding UpdateReadyVersion, Mode=OneWay}" /><Run Text=" ready  ·  Restart to update" />
                </TextBlock>
            </ui:Button>
        </Grid>

        <!-- Notifications -->
        <StackPanel Grid.Row="2" Margin="24,0,24,0">
            <ui:InfoBar Title="Farming Simulator 25 is running"
                        Message="Changes take effect after restarting the game."
                        Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                        IsOpen="{Binding IsGameRunning}" />
            <ui:InfoBar Title="{Binding StatusTitle}" Message="{Binding StatusMessage}"
                        Severity="{Binding StatusSeverity}" Margin="0,0,0,12"
                        IsOpen="{Binding IsStatusOpen, Mode=TwoWay}" />
        </StackPanel>

        <!-- ═════════════ Mods page ═════════════ -->
        <Grid Grid.Row="3" Visibility="{Binding IsModsPage, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,4,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mods" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <ui:SymbolIcon Symbol="Games24" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ModsDirectory}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <ui:SymbolIcon Symbol="Archive24" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding BackupDirectory}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <ui:Button Content="Mods folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenModsFolderCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Backup folder" Icon="{ui:SymbolIcon Archive24}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0" />
                <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Install mods" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                           ToolTip="Pick .zip files — or just drag and drop them onto the window"
                           Command="{Binding BrowseAndInstallCommand}" />
            </StackPanel>
        </Grid>

        <!-- Stats -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,16">
            <Border Style="{StaticResource StatCard}" MinWidth="140">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalCount}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="Total mods" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" MinWidth="140">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding ActiveCount}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource StatLabel}">
                        <Run Text="Active" /><Run Text="  ·  " /><Run Text="{Binding ActiveSize, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" MinWidth="140">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding InactiveCount}" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="In backup" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" MinWidth="140">
                <StackPanel>
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding IssueCount}" Foreground="#FFFFCA28" />
                    <TextBlock Style="{StaticResource StatLabel}" Text="Issues" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" MinWidth="140">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding UnusedCount}" />
                        <TextBlock Style="{StaticResource StatLabel}" ToolTip="Mods that no savegame needs">
                            <Run Text="Unused" /><Run Text="  ·  " /><Run Text="{Binding UnusedSize, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Disable all" Icon="{ui:SymbolIcon ArchiveArrowBack24}" Margin="20,0,0,0"
                               VerticalAlignment="Center" ToolTip="Move every unused mod to the backup folder"
                               Command="{Binding DisableUnusedCommand}"
                               Visibility="{Binding UnusedCount, Converter={StaticResource PositiveToVis}}" />
                </Grid>
            </Border>
        </StackPanel>


        <!-- Toolbar -->
        <Grid Grid.Row="3" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="Search by name, file or author…" Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource FilterPill}" Content="All"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ModFilter.All}}" />
                <RadioButton Style="{StaticResource FilterPill}" Content="Active"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ModFilter.Active}}" />
                <RadioButton Style="{StaticResource FilterPill}" Content="Disabled"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ModFilter.Inactive}}" />
                <RadioButton Style="{StaticResource FilterPill}" Content="Issues"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ModFilter.Issues}}" />
                <RadioButton Style="{StaticResource FilterPill}" Content="Unused" ToolTip="Mods that no savegame needs"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ModFilter.Unused}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sort" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="4" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ModList" ItemsSource="{Binding ModsView}"
                             ItemTemplate="{StaticResource ModRowTemplate}"
                             ItemContainerStyle="{StaticResource ModRowContainer}"
                             SelectedItem="{Binding SelectedMod}"
                             SelectionMode="Extended"
                             SelectionChanged="ModList_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Padding="6"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" />
                        <TextBlock Text="Scanning mods…" Style="{StaticResource Caption}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Bulk actions -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                        <Grid>
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" selected  ·  Ctrl/Shift+click to select multiple" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Disable selected" Icon="{ui:SymbolIcon DismissCircle24}" Margin="0,0,8,0"
                                           Command="{Binding DisableSelectedCommand}"
                                           CommandParameter="{Binding SelectedItems, ElementName=ModList}" />
                                <ui:Button Content="Enable selected" Icon="{ui:SymbolIcon CheckmarkCircle24}" Appearance="Primary"
                                           Command="{Binding EnableSelectedCommand}"
                                           CommandParameter="{Binding SelectedItems, ElementName=ModList}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="1" Margin="16,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding SelectedMod, Converter={StaticResource NullToVis}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select a mod to see details" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>

                    <ScrollViewer DataContext="{Binding SelectedMod}" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Converter={StaticResource NotNullToVis}}">
                        <StackPanel Margin="20">
                            <Border Width="128" Height="128" CornerRadius="10" ClipToBounds="True" HorizontalAlignment="Left"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Box24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,128,128" RadiusX="10" RadiusY="10" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="0,3" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Grid.Row="0" Text="Status" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,3" />
                                            <Setter Property="Text" Value="Disabled (in backup)" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="Active" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Text="Version" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" />
                                <TextBlock Grid.Row="2" Text="Author" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Author}" />
                                <TextBlock Grid.Row="3" Text="Size" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource BytesToString}}" />
                                <TextBlock Grid.Row="4" Text="Modified" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                <TextBlock Grid.Row="5" Text="Requires" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Dependencies}" Margin="0,3" />
                                <TextBlock Grid.Row="6" Text="Used in" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding UsedInSaves, TargetNullValue='No savegame'}" />
                            </Grid>

                            <ui:InfoBar Title="Missing dependencies" Message="{Binding MissingDependencies}" Severity="Warning"
                                        IsClosable="False" Margin="0,12,0,0"
                                        IsOpen="True"
                                        Visibility="{Binding MissingDependencies, Converter={StaticResource NotNullToVis}}" />
                            <ui:InfoBar Title="Same mod exists in both folders" Severity="Warning"
                                        Message="Another copy with this name is in the other folder."
                                        IsClosable="False" Margin="0,12,0,0"
                                        IsOpen="{Binding HasDuplicate, Mode=OneWay}" />
                            <ui:InfoBar Title="modDesc.xml could not be read" Message="{Binding Error}" Severity="Error"
                                        IsClosable="False" Margin="0,12,0,0"
                                        IsOpen="True"
                                        Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
                            <ui:InfoBar Title="Invalid file name" Severity="Error"
                                        Message="The game only loads mods named with letters, numbers and _ (no spaces or brackets)."
                                        IsClosable="False" Margin="0,12,0,0"
                                        IsOpen="{Binding HasInvalidName, Mode=OneWay}" />

                            <WrapPanel Margin="0,16,0,0">
                                <ui:Button Icon="{ui:SymbolIcon Folder24}" Content="Show in Explorer" Margin="0,0,8,8"
                                           Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Icon="{ui:SymbolIcon Wrench24}" Content="Fix file name" Appearance="Primary" Margin="0,0,8,8"
                                           Visibility="{Binding HasInvalidName, Converter={StaticResource BoolToVis}}"
                                           Command="{Binding DataContext.FixNameCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                           CommandParameter="{Binding}" />
                            </WrapPanel>

                            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,20,0,6"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Visibility="{Binding Description, Converter={StaticResource NotNullToVis}}" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <!-- ═════════════ Savegames page ═════════════ -->
        <Grid Grid.Row="3" Margin="24,0,24,24" Visibility="{Binding IsSavegamesPage, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <Grid Grid.ColumnSpan="2" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="Savegames" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="See which mods each savegame needs, bring back the ones in the backup folder, or load only one save's mods." />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Content="Refresh" Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- Savegame list -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <ListBox ItemsSource="{Binding Savegames}" SelectedItem="{Binding SelectedSavegame}"
                             ItemTemplate="{StaticResource SavegameCardTemplate}"
                             ItemContainerStyle="{StaticResource ModRowContainer}"
                             Background="Transparent" BorderThickness="0" Padding="6"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <TextBlock Text="No savegames found" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Savegames.Count, Converter={StaticResource PositiveToVis}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Row="1" Grid.Column="1" Margin="16,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer DataContext="{Binding SelectedSavegame}" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Converter={StaticResource NotNullToVis}}">
                    <StackPanel Margin="24">
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding FolderPath, Mode=OneWay}" />
                        </TextBlock>

                        <!-- Facts -->
                        <UniformGrid Columns="4" Margin="0,16,0,0">
                            <UniformGrid.Resources>
                                <Style TargetType="Border" BasedOn="{StaticResource StatCard}">
                                    <Setter Property="Margin" Value="0,0,10,0" />
                                    <Setter Property="Padding" Value="14,10" />
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                </Style>
                            </UniformGrid.Resources>
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding MoneyText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="Money" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding PlayTimeText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="Play time" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding SaveDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="Last saved" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CreationDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="Created" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <ui:InfoBar Title="Could not read this savegame" Message="{Binding Error}" Severity="Error"
                                    IsClosable="False" IsOpen="True" Margin="0,16,0,0"
                                    Visibility="{Binding Error, Converter={StaticResource NotNullToVis}}" />
                        <ui:InfoBar Title="Some mods are not installed" Severity="Error" IsClosable="False" IsOpen="True" Margin="0,16,0,0"
                                    Message="This savegame uses mods that are in neither the mods folder nor the backup folder. Download them from ModHub before loading the save, or their vehicles and buildings will be lost."
                                    Visibility="{Binding MissingCount, Converter={StaticResource PositiveToVis}}" />

                        <!-- Actions -->
                        <WrapPanel Margin="0,16,0,0">
                            <ui:Button Icon="{ui:SymbolIcon CheckmarkCircle24}" Appearance="Primary" Margin="0,0,8,8"
                                       ToolTip="Move the mods this save needs out of the backup folder"
                                       Command="{Binding DataContext.EnableNeededModsCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                       CommandParameter="{Binding}">
                                <TextBlock>
                                    <Run Text="Enable what this save needs" /><Run Text="{Binding DisabledNeededCount, Mode=OneWay, StringFormat=' ({0})'}" />
                                </TextBlock>
                            </ui:Button>
                            <ui:Button Icon="{ui:SymbolIcon Filter24}" Margin="0,0,8,8"
                                       Content="Use only this save's mods"
                                       Command="{Binding DataContext.UseOnlySaveModsCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                       CommandParameter="{Binding}">
                                <ui:Button.ToolTip>
                                    <TextBlock>
                                        <Run Text="Enables" /> <Run Text="{Binding ToEnableCount, Mode=OneWay}" /> <Run Text="mod(s) and moves" />
                                        <Run Text="{Binding ToDisableCount, Mode=OneWay}" /> <Run Text="mod(s) this save doesn't use to the backup folder." />
                                    </TextBlock>
                                </ui:Button.ToolTip>
                            </ui:Button>
                            <ui:Button Icon="{ui:SymbolIcon Folder24}" Content="Open folder" Margin="0,0,8,8"
                                       Command="{Binding DataContext.OpenSavegameFolderCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                       CommandParameter="{Binding}" />
                        </WrapPanel>

                        <!-- Needed mods -->
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,16,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="Needed by this save" /><Run Text="{Binding NeededCount, Mode=OneWay, StringFormat=' ({0})'}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="The map, mods whose vehicles, buildings or items are in this save, selected script mods, and everything they depend on." />
                        <ItemsControl ItemsSource="{Binding NeededMods}" ItemTemplate="{StaticResource SaveModRowTemplate}" />

                        <!-- Other selected mods -->
                        <Expander Margin="0,16,0,0" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="Selected, but nothing from them is in this save" /><Run Text="{Binding OtherMods.Count, Mode=OneWay, StringFormat=' ({0})'}" />
                                </TextBlock>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding OtherMods}" ItemTemplate="{StaticResource SaveModRowTemplate}"
                                          VirtualizingPanel.IsVirtualizing="True" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═════════════ About page ═════════════ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAboutPage, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="760" Margin="24,4,24,32" HorizontalAlignment="Left">

                <!-- App hero -->
                <Border Style="{StaticResource StatCard}" Margin="0,0,0,16" Padding="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Assets/app.png" Width="96" Height="96"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static app:AppInfo.Name}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentFillColorDefaultBrush}" Padding="10,3">
                                    <TextBlock Style="{StaticResource BadgeText}" FontSize="12"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                                        <Run Text="Version" /> <Run Text="{x:Static app:AppInfo.Version}" />
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="10,3">
                                    <TextBlock Style="{StaticResource BadgeText}" FontSize="12" Text="Farming Simulator 25"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Static app:AppInfo.Tagline}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Developer -->
                <TextBlock Text="Developer" FontSize="16" FontWeight="SemiBold" Margin="2,8,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Style="{StaticResource StatCard}" Margin="0,0,0,16" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="32" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#81C332" Offset="0" />
                                    <GradientStop Color="#026D63" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding Source={x:Static app:AppInfo.DeveloperName}, Converter={StaticResource Initials}}"
                                       FontSize="24" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="{x:Static app:AppInfo.DeveloperName}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Static app:AppInfo.DeveloperBio}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <WrapPanel Margin="0,14,0,0">
                                <ui:Button Icon="{ui:SymbolIcon Globe24}" Content="guclukol.net" Appearance="Primary" Margin="0,0,8,8"
                                           ToolTip="{x:Static app:AppInfo.WebsiteUrl}"
                                           Visibility="{Binding Source={x:Static app:AppInfo.WebsiteUrl}, Converter={StaticResource NotNullToVis}}"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static app:AppInfo.WebsiteUrl}" />
                                <ui:Button Icon="{ui:SymbolIcon Code24}" Content="GitHub" Margin="0,0,8,8"
                                           ToolTip="{x:Static app:AppInfo.GitHubUrl}"
                                           Visibility="{Binding Source={x:Static app:AppInfo.GitHubUrl}, Converter={StaticResource NotNullToVis}}"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static app:AppInfo.GitHubUrl}" />
                                <ui:Button Icon="{ui:SymbolIcon Mail24}" Content="Contact" Margin="0,0,8,8"
                                           ToolTip="{x:Static app:AppInfo.Email}"
                                           Visibility="{Binding Source={x:Static app:AppInfo.Email}, Converter={StaticResource NotNullToVis}}"
                                           Command="{Binding OpenLinkCommand}" CommandParameter="{x:Static app:AppInfo.Email}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- How it works -->
                <TextBlock Text="How it works" FontSize="16" FontWeight="SemiBold" Margin="2,8,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Style="{StaticResource StatCard}" Margin="0,0,0,16" Padding="24,18">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Style>
                        </StackPanel.Resources>
                        <DockPanel Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="ToggleLeft24" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock>Disabling a mod moves it to <Bold>fs25modbackup</Bold> on your desktop. Enabling moves it back into the game's mods folder. Nothing is ever deleted.</TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock>Drag and drop .zip files onto the window to install them. Mod bundles are unpacked and names like "FS25_Mod (1).zip" are fixed automatically.</TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <ui:SymbolIcon Symbol="Delete24" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock>When a mod gets replaced, the old copy goes to the Recycle Bin so you can always restore it.</TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" Margin="2,8,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Style="{StaticResource StatCard}" Margin="0,0,0,16" Padding="24,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Margin="0,0,14,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <Run Text="Version" /> <Run Text="{x:Static app:AppInfo.Version}" />
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar Margin="0,8,0,0" Height="4" Maximum="100" Value="{Binding UpdateProgress}"
                                         Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ui:Button Content="Restart to update" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary"
                                       Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}"
                                       Command="{Binding RestartToUpdateCommand}" />
                            <ui:Button Content="Check for updates" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       Visibility="{Binding IsUpdateReady, Converter={StaticResource InverseBoolToVis}}"
                                       IsEnabled="{Binding CanUpdate}"
                                       Command="{Binding CheckForUpdatesCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Credits -->
                <TextBlock Text="Open-source libraries" FontSize="16" FontWeight="SemiBold" Margin="2,8,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Style="{StaticResource StatCard}" Margin="0,0,0,20" Padding="12,8">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="CreditLink" TargetType="ui:HyperlinkButton" BasedOn="{StaticResource {x:Type ui:HyperlinkButton}}">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </StackPanel.Resources>
                        <ui:HyperlinkButton Style="{StaticResource CreditLink}" NavigateUri="https://github.com/lepoco/wpfui"
                                            Content="WPF UI — Fluent design controls  ·  MIT" />
                        <ui:HyperlinkButton Style="{StaticResource CreditLink}" NavigateUri="https://github.com/CommunityToolkit/dotnet"
                                            Content="CommunityToolkit.Mvvm — MVVM helpers  ·  MIT" />
                        <ui:HyperlinkButton Style="{StaticResource CreditLink}" NavigateUri="https://github.com/nickbabcock/Pfim"
                                            Content="Pfim — DDS icon decoding  ·  MIT" />
                        <ui:HyperlinkButton Style="{StaticResource CreditLink}" NavigateUri="https://github.com/velopack/velopack"
                                            Content="Velopack — installer and updates  ·  MIT" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static app:AppInfo.Copyright}" Margin="2,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,6,0,0"
                           Text="Not affiliated with or endorsed by GIANTS Software. Farming Simulator is a trademark of GIANTS Software GmbH." />
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════ Drag & drop overlay ═════════════ -->
        <Border Grid.Row="1" Grid.RowSpan="3" Margin="16" CornerRadius="12" IsHitTestVisible="False"
                Background="#D91C2A14"
                Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="6 4"
                           Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload48" FontSize="56" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Drop mods to install" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,0"
                               HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock Text=".zip files, mod bundles or unpacked mod folders" Margin="0,6,0,0"
                               HorizontalAlignment="Center" Foreground="#CCFFFFFF" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════ Installing overlay ═════════════ -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="#B3000000"
                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock Text="Installing mods…" FontSize="16" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
